# Copy to .env for local development. Never commit real secrets.

# --- Database (local Docker MySQL) ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=modernmarket
MYSQL_USER=modernmarket
MYSQL_PASSWORD=change_me_app
DATABASE_URL="mysql://modernmarket:change_me_app@localhost:3306/modernmarket"

# --- Redis (rate limiting, queues) ---
REDIS_URL="redis://localhost:6379"

# --- API ---
NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:4200

# --- Auth ---
# Generate long random values, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change_me_access
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# Frontend base URL, used for links in emails
APP_BASE_URL=http://localhost:4200

# --- Email (development: log to console) ---
MAIL_TRANSPORT=console
MAIL_FROM="Modernmarket <no-reply@localhost>"

# --- Object storage (later milestone; S3-compatible) ---
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Business defaults (overridable in platform_settings) ---
DEFAULT_COMMISSION_PERCENT=10.00
