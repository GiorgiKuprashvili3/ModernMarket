// Modernmarket database schema.
// Part 1 (Milestone 1): identity, authentication, seller onboarding, and platform foundations.
// Catalog, inventory, orders and finance models are added in later steps/milestones.
//
// Conventions:
//  - Internal primary keys are BigInt auto-increment and never leave the backend.
//  - Public identifiers are `uuid` columns.
//  - Money is Decimal (GEL only). Timestamps are UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Enums

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  BLOCKED
}

enum Locale {
  ka
  en
}

enum DisplayCurrency {
  GEL
  USD
  EUR
}

enum SellerType {
  INDIVIDUAL
  BUSINESS
}

enum SellerStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

// ---------------------------------------------------------------- Identity

model User {
  id                BigInt          @id @default(autoincrement())
  uuid              String          @unique @default(uuid()) @db.Char(36)
  email             String          @unique @db.VarChar(255)
  passwordHash      String          @map("password_hash") @db.VarChar(255)
  status            UserStatus      @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?       @map("email_verified_at")
  locale            Locale          @default(ka)
  displayCurrency   DisplayCurrency @default(GEL) @map("display_currency")
  lastLoginAt       DateTime?       @map("last_login_at")
  failedLoginCount  Int             @default(0) @map("failed_login_count")
  lockedUntil       DateTime?       @map("locked_until")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  roles                  UserRole[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  buyerProfile           BuyerProfile?
  sellerProfile          SellerProfile?
  addresses              Address[]
  auditLogs              AuditLog[]
  cart                   Cart?
  wishlist               Wishlist?
  comparison             Comparison?
  orders                 Order[]

  @@map("users")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @db.VarChar(64) // buyer, seller, admin, super_admin, ...
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @db.VarChar(100) // e.g. products.moderate, invoices.issue
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    BigInt   @map("user_id")
  roleId    BigInt   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------- Auth tokens
// Only hashes are stored. Refresh tokens rotate on every use; `familyId` groups a
// rotation chain so reuse of an old token can revoke the whole family.

model RefreshToken {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  familyId     String    @map("family_id") @db.Char(36)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById BigInt?   @map("replaced_by_id")
  ip           String?   @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------------- Profiles

model BuyerProfile {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @unique @map("user_id")
  firstName   String   @map("first_name") @db.VarChar(100)
  lastName    String   @map("last_name") @db.VarChar(100)
  phone       String?  @db.VarChar(32)
  preferences Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("buyer_profiles")
}

model SellerProfile {
  id                  BigInt       @id @default(autoincrement())
  uuid                String       @unique @default(uuid()) @db.Char(36)
  userId              BigInt       @unique @map("user_id")
  sellerType          SellerType   @map("seller_type")
  legalName           String       @map("legal_name") @db.VarChar(255)
  // Georgian personal (11-digit) or company identification number.
  // Stored encrypted at the application layer; never logged.
  identificationEnc   String?      @map("identification_enc") @db.Text
  phone               String       @db.VarChar(32)
  contactAddress      String       @map("contact_address") @db.VarChar(500)
  status              SellerStatus @default(PENDING)
  approvedAt          DateTime?    @map("approved_at")
  approvedById        BigInt?      @map("approved_by_id")
  suspendedAt         DateTime?    @map("suspended_at")
  suspendedReason     String?      @map("suspended_reason") @db.VarChar(500)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications SellerApplication[]
  store        SellerStore?
  products     Product[]
  sellerOrders SellerOrder[]
  commissionRules CommissionRule[]
  ledgerEntries SellerCommissionLedger[]
  balance      SellerBalance?
  invoices     SellerInvoice[]
  subscriptions SellerSubscription[]
  promotions   Promotion[]

  @@index([status])
  @@map("seller_profiles")
}

model Address {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @unique @default(uuid()) @db.Char(36)
  userId    BigInt   @map("user_id")
  label     String?  @db.VarChar(64)
  recipient String   @db.VarChar(150)
  phone     String   @db.VarChar(32)
  city      String   @db.VarChar(100)
  district  String?  @db.VarChar(100)
  street    String   @db.VarChar(255)
  building  String?  @db.VarChar(64)
  notes     String?  @db.VarChar(500)
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------- Seller onboarding

model SellerApplication {
  id              BigInt            @id @default(autoincrement())
  uuid            String            @unique @default(uuid()) @db.Char(36)
  sellerProfileId BigInt            @map("seller_profile_id")
  status          ApplicationStatus @default(PENDING)
  storeName       String            @map("store_name") @db.VarChar(150)
  storeDescription String?          @map("store_description") @db.Text
  revisionNo      Int               @default(1) @map("revision_no")
  submittedAt     DateTime          @default(now()) @map("submitted_at")
  reviewedById    BigInt?           @map("reviewed_by_id")
  reviewedAt      DateTime?         @map("reviewed_at")
  rejectionReason String?           @map("rejection_reason") @db.VarChar(1000)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  sellerProfile SellerProfile    @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  documents     SellerDocument[]

  @@index([sellerProfileId])
  @@index([status, submittedAt])
  @@map("seller_applications")
}

model SellerDocument {
  id            BigInt   @id @default(autoincrement())
  uuid          String   @unique @default(uuid()) @db.Char(36)
  applicationId BigInt   @map("application_id")
  docType       String   @map("doc_type") @db.VarChar(64)
  // Key inside the PRIVATE bucket. Never exposed directly; access goes through the API.
  storageKey    String   @map("storage_key") @db.VarChar(255)
  mimeType      String   @map("mime_type") @db.VarChar(100)
  sizeBytes     Int      @map("size_bytes")
  checksum      String   @db.Char(64)
  createdAt     DateTime @default(now()) @map("created_at")

  application SellerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("seller_documents")
}

// ---------------------------------------------------------------- Platform foundations

// Append-only: the application never updates or deletes rows.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt?  @map("actor_id")
  actorRole  String?  @map("actor_role") @db.VarChar(64)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.VarChar(64)
  before     Json?
  after      Json?
  reason     String?  @db.VarChar(1000)
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// Transactional outbox: written in the same transaction as the change, dispatched by a worker.
model OutboxEvent {
  id            BigInt       @id @default(autoincrement())
  eventType     String       @map("event_type") @db.VarChar(100)
  aggregateType String       @map("aggregate_type") @db.VarChar(64)
  aggregateId   String       @map("aggregate_id") @db.VarChar(64)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error") @db.Text
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  processedAt   DateTime?    @map("processed_at")

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model PlatformSetting {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  updatedById BigInt?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// Stores the response of a state-changing request so a retry with the same key
// (e.g. checkout) returns the original result instead of creating a duplicate.
model IdempotencyKey {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  key          String   @db.VarChar(128)
  requestHash  String   @map("request_hash") @db.Char(64)
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ================================================================ Part 2: catalog and inventory
//
// Design decisions:
//  - Every physical or digital product has at least one variant (a "default" variant for simple
//    products). Price, SKU and stock live on the variant, so cart/order/inventory code has a
//    single purchasable unit. Vehicles have no variants and no inventory (inquiry-only).
//  - FULLTEXT indexes on product_translations are created in a raw-SQL migration
//    (Prisma cannot express everything we need for Georgian search tuning).
//  - The single exactly-one-of / range CHECK constraints are also added in raw SQL.

enum StoreStatus {
  OPEN
  CLOSED
  SUSPENDED
}

enum ProductKind {
  PHYSICAL
  DIGITAL
  VEHICLE
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum ProductStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
  SUSPENDED
}

enum ModerationAction {
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED_AFTER_EDIT
  SUSPENDED
  REINSTATED
}

enum AttributeType {
  TEXT
  NUMBER
  ENUM
  BOOLEAN
}

enum VehicleListingStatus {
  AVAILABLE
  RESERVED
  SOLD
  ARCHIVED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUG_IN_HYBRID
  ELECTRIC
  LPG
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
  CVT
}

enum DriveType {
  FWD
  RWD
  AWD
  FOUR_WD
}

enum InventoryMovementType {
  INITIAL
  ADJUSTMENT
  RESERVE
  RELEASE
  COMMIT
  RESTOCK
}

model SellerStore {
  id              BigInt      @id @default(autoincrement())
  uuid            String      @unique @default(uuid()) @db.Char(36)
  sellerProfileId BigInt      @unique @map("seller_profile_id")
  slug            String      @unique @db.VarChar(120)
  name            String      @db.VarChar(150)
  descriptionKa   String?     @map("description_ka") @db.Text
  descriptionEn   String?     @map("description_en") @db.Text
  policiesKa      String?     @map("policies_ka") @db.Text
  policiesEn      String?     @map("policies_en") @db.Text
  location        String?     @db.VarChar(255)
  logoKey         String?     @map("logo_key") @db.VarChar(255)
  coverKey        String?     @map("cover_key") @db.VarChar(255)
  status          StoreStatus @default(OPEN)
  ratingAvg       Decimal     @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount     Int         @default(0) @map("rating_count")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  products      Product[]

  @@map("seller_stores")
}

model Category {
  id                BigInt      @id @default(autoincrement())
  uuid              String      @unique @default(uuid()) @db.Char(36)
  parentId          BigInt?     @map("parent_id")
  slug              String      @unique @db.VarChar(150)
  // Materialized path of ancestor ids, e.g. "/1/14/" for fast subtree queries.
  path              String      @db.VarChar(255)
  depth             Int         @default(0)
  sortOrder         Int         @default(0) @map("sort_order")
  isActive          Boolean     @default(true) @map("is_active")
  imageKey          String?     @map("image_key") @db.VarChar(255)
  // Which product kind this category hosts; vehicles must live under a vehicle category.
  productKind       ProductKind @default(PHYSICAL) @map("product_kind")
  // Optional category-level commission override (resolved by the commission module).
  commissionPercent Decimal?    @map("commission_percent") @db.Decimal(5, 2)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  parent        Category?               @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Category[]              @relation("CategoryTree")
  commissionRules CommissionRule[]
  translations  CategoryTranslation[]
  products      Product[]
  attributes    AttributeDefinition[]

  @@index([parentId, sortOrder])
  @@index([path])
  @@map("categories")
}

model CategoryTranslation {
  id             BigInt  @id @default(autoincrement())
  categoryId     BigInt  @map("category_id")
  locale         Locale
  name           String  @db.VarChar(150)
  description    String? @db.Text
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(500)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model Brand {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @unique @default(uuid()) @db.Char(36)
  slug      String   @unique @db.VarChar(150)
  name      String   @db.VarChar(150)
  logoKey   String?  @map("logo_key") @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model Product {
  id                 BigInt           @id @default(autoincrement())
  uuid               String           @unique @default(uuid()) @db.Char(36)
  sellerProfileId    BigInt           @map("seller_profile_id")
  storeId            BigInt           @map("store_id")
  categoryId         BigInt           @map("category_id")
  brandId            BigInt?          @map("brand_id")
  kind               ProductKind
  slug               String           @unique @db.VarChar(200)
  condition          ProductCondition @default(NEW)
  location           String?          @db.VarChar(255)
  // Display price of the cheapest active variant, kept in sync by the service for fast listing/sorting.
  // Never used for checkout; the variant price is authoritative.
  minPriceGel        Decimal?         @map("min_price_gel") @db.Decimal(12, 2)
  compareAtPriceGel  Decimal?         @map("compare_at_price_gel") @db.Decimal(12, 2)
  discountPercent    Int              @default(0) @map("discount_percent")
  status             ProductStatus    @default(DRAFT)
  moderationRevision Int              @default(0) @map("moderation_revision")
  publishedAt        DateTime?        @map("published_at")
  ratingAvg          Decimal          @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount        Int              @default(0) @map("rating_count")
  viewCount          Int              @default(0) @map("view_count")
  salesCount         Int              @default(0) @map("sales_count")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")

  seller        SellerProfile              @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  store         SellerStore                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category      Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand         Brand?                     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  translations  ProductTranslation[]
  images        ProductImage[]
  variants      ProductVariant[]
  attributes    ProductAttributeValue[]
  moderation    ProductModerationHistory[]
  vehicle       VehicleDetails?
  digitalFiles  DigitalProductFile[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  comparisonItems ComparisonItem[]
  recentlyViewed RecentlyViewed[]
  promotions     Promotion[]

  @@index([status, categoryId, publishedAt])
  @@index([sellerProfileId, status])
  @@index([status, minPriceGel])
  @@index([status, ratingAvg])
  @@index([status, salesCount])
  @@index([brandId])
  @@map("products")
}

model ProductTranslation {
  id             BigInt  @id @default(autoincrement())
  productId      BigInt  @map("product_id")
  locale         Locale
  title          String  @db.VarChar(255)
  description    String  @db.Text
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(500)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  // FULLTEXT (title, description) is added in a raw-SQL migration.
  @@map("product_translations")
}

model ProductVariant {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique @default(uuid()) @db.Char(36)
  productId  BigInt   @map("product_id")
  sku        String   @db.VarChar(100)
  priceGel   Decimal  @map("price_gel") @db.Decimal(12, 2)
  // Free-form configurable options, e.g. {"size":"M","color":"Black"}.
  options    Json?
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?
  images    ProductImage[]
  cartItems CartItem[]
  orderItems OrderItem[]

  // SKU is unique within a product; cross-product uniqueness per seller is enforced in the service.
  @@unique([productId, sku])
  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id         BigInt   @id @default(autoincrement())
  productId  BigInt   @map("product_id")
  variantId  BigInt?  @map("variant_id")
  storageKey String   @map("storage_key") @db.VarChar(255)
  altKa      String?  @map("alt_ka") @db.VarChar(255)
  altEn      String?  @map("alt_en") @db.VarChar(255)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// Category-specific attribute definitions drive filters, specifications and comparison.
model AttributeDefinition {
  id            BigInt        @id @default(autoincrement())
  categoryId    BigInt        @map("category_id")
  key           String        @db.VarChar(64)
  type          AttributeType
  nameKa        String        @map("name_ka") @db.VarChar(150)
  nameEn        String        @map("name_en") @db.VarChar(150)
  // For ENUM type: [{ "value": "ssd", "ka": "...", "en": "SSD" }, ...]
  options       Json?
  unit          String?       @db.VarChar(32)
  isFilterable  Boolean       @default(false) @map("is_filterable")
  isComparable  Boolean       @default(false) @map("is_comparable")
  isRequired    Boolean       @default(false) @map("is_required")
  sortOrder     Int           @default(0) @map("sort_order")

  category Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values   ProductAttributeValue[]

  @@unique([categoryId, key])
  @@map("attribute_definitions")
}

model ProductAttributeValue {
  id            BigInt   @id @default(autoincrement())
  productId     BigInt   @map("product_id")
  attributeId   BigInt   @map("attribute_id")
  valueText     String?  @map("value_text") @db.VarChar(500)
  valueNumber   Decimal? @map("value_number") @db.Decimal(18, 4)
  valueBoolean  Boolean? @map("value_boolean")
  optionValue   String?  @map("option_value") @db.VarChar(100)

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([attributeId, optionValue])
  @@index([attributeId, valueNumber])
  @@map("product_attribute_values")
}

// Append-only record of every moderation decision.
model ProductModerationHistory {
  id         BigInt           @id @default(autoincrement())
  productId  BigInt           @map("product_id")
  revisionNo Int              @map("revision_no")
  action     ModerationAction
  actorId    BigInt?          @map("actor_id")
  reason     String?          @db.VarChar(1000)
  // What was reviewed at that moment.
  snapshot   Json?
  createdAt  DateTime         @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("product_moderation_history")
}

model VehicleDetails {
  id            BigInt               @id @default(autoincrement())
  productId     BigInt               @unique @map("product_id")
  manufacturer  String               @db.VarChar(100)
  model         String               @db.VarChar(100)
  year          Int
  mileageKm     Int                  @map("mileage_km")
  engine        String?              @db.VarChar(100)
  fuelType      FuelType             @map("fuel_type")
  transmission  Transmission
  driveType     DriveType?           @map("drive_type")
  priceGel      Decimal              @map("price_gel") @db.Decimal(12, 2)
  listingStatus VehicleListingStatus @default(AVAILABLE) @map("listing_status")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([manufacturer, model, year])
  @@index([listingStatus])
  @@map("vehicle_details")
}

model DigitalProductFile {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique @default(uuid()) @db.Char(36)
  productId  BigInt   @map("product_id")
  // Key inside the PRIVATE bucket; never exposed. Downloads go through an authorized API endpoint.
  storageKey String   @map("storage_key") @db.VarChar(255)
  filename   String   @db.VarChar(255)
  sizeBytes  BigInt   @map("size_bytes")
  checksum   String   @db.Char(64)
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("digital_product_files")
}

// ---------------------------------------------------------------- Inventory
// Stock is decremented atomically in the checkout transaction:
//   UPDATE inventory SET quantity_on_hand = quantity_on_hand - :q
//   WHERE id = :id AND quantity_on_hand >= :q
// A CHECK (quantity_on_hand >= 0) is added in the raw-SQL migration as a second line of defense.

model Inventory {
  id               BigInt   @id @default(autoincrement())
  variantId        BigInt   @unique @map("variant_id")
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  lowStockThreshold Int     @default(3) @map("low_stock_threshold")
  updatedAt        DateTime @updatedAt @map("updated_at")

  variant   ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@map("inventory")
}

// Append-only ledger of every stock change.
model InventoryMovement {
  id            BigInt                @id @default(autoincrement())
  inventoryId   BigInt                @map("inventory_id")
  type          InventoryMovementType
  delta         Int
  referenceType String?               @map("reference_type") @db.VarChar(64)
  referenceId   String?               @map("reference_id") @db.VarChar(64)
  actorId       BigInt?               @map("actor_id")
  note          String?               @db.VarChar(500)
  createdAt     DateTime              @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// ================================================================ Part 3: shopping, orders, COD payments
//
// Orders are snapshots: titles, SKUs, option values, unit prices and the applied commission rate are
// copied at placement and never recomputed. Order status and payment status are separate state
// machines (payment_records is not a column on seller_orders). Status history tables are append-only.

enum ParentOrderStatus {
  PLACED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  CANCELLED
}

enum SellerOrderStatus {
  PENDING
  ACCEPTED
  PROCESSING
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
  DISPUTED
}

enum CommissionStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  RECOGNIZED
  REVERSED
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
  REFUNDED
}

enum DeliveryMethod {
  SELLER_DELIVERY
  BUYER_PICKUP
  COURIER_ARRANGED
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  AWAITING_COLLECTION
  COLLECTED_BY_SELLER
  NOT_COLLECTED
  PAYMENT_DISPUTED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECORDED
}

enum DisputeType {
  NON_DELIVERY
  NOT_AS_DESCRIBED
  PAYMENT_DISAGREEMENT
  OTHER
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED_FOR_BUYER
  RESOLVED_FOR_SELLER
  CLOSED
}

// ---------------------------------------------------------------- Shopping

model Cart {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

// Holds references and quantity only. Prices are always read from the variant, never stored here.
model CartItem {
  id        BigInt   @id @default(autoincrement())
  cartId    BigInt   @map("cart_id")
  variantId BigInt   @map("variant_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @unique @map("user_id")
  // Set only when the buyer chooses to share; revocable by clearing it.
  shareToken String?  @unique @map("share_token") @db.Char(32)
  createdAt  DateTime @default(now()) @map("created_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         BigInt   @id @default(autoincrement())
  wishlistId BigInt   @map("wishlist_id")
  productId  BigInt   @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

model Comparison {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ComparisonItem[]

  @@map("comparisons")
}

model ComparisonItem {
  id           BigInt   @id @default(autoincrement())
  comparisonId BigInt   @map("comparison_id")
  productId    BigInt   @map("product_id")
  createdAt    DateTime @default(now()) @map("created_at")

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, productId])
  @@map("comparison_items")
}

// Either userId (signed in) or anonymousId (guest cookie id) is set; pruned to the latest N per owner.
model RecentlyViewed {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt?  @map("user_id")
  anonymousId String?  @map("anonymous_id") @db.Char(36)
  productId   BigInt   @map("product_id")
  viewedAt    DateTime @default(now()) @map("viewed_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([anonymousId, viewedAt])
  @@map("recently_viewed")
}

// ---------------------------------------------------------------- Orders

// Parent checkout record shown to the buyer as one consolidated order.
// Its status is derived from the seller orders and recomputed whenever one changes.
model Order {
  id               BigInt            @id @default(autoincrement())
  uuid             String            @unique @default(uuid()) @db.Char(36)
  orderNumber      String            @unique @map("order_number") @db.VarChar(32)
  buyerId          BigInt            @map("buyer_id")
  idempotencyKey   String            @map("idempotency_key") @db.VarChar(128)
  contactName      String            @map("contact_name") @db.VarChar(150)
  contactPhone     String            @map("contact_phone") @db.VarChar(32)
  contactEmail     String            @map("contact_email") @db.VarChar(255)
  // Address (or pickup choice) copied at placement so later edits never change history.
  shippingSnapshot Json              @map("shipping_snapshot")
  totalGel         Decimal           @map("total_gel") @db.Decimal(12, 2)
  status           ParentOrderStatus @default(PLACED)
  placedAt         DateTime          @default(now()) @map("placed_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  buyer        User          @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  sellerOrders SellerOrder[]

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId, placedAt])
  @@map("orders")
}

// One per seller per checkout. Sellers only ever see and manage their own seller orders.
model SellerOrder {
  id                BigInt            @id @default(autoincrement())
  uuid              String            @unique @default(uuid()) @db.Char(36)
  orderId           BigInt            @map("order_id")
  sellerProfileId   BigInt            @map("seller_profile_id")
  sellerOrderNumber String            @unique @map("seller_order_number") @db.VarChar(40)
  status            SellerOrderStatus @default(PENDING)
  subtotalGel       Decimal           @map("subtotal_gel") @db.Decimal(12, 2)
  discountGel       Decimal           @default(0) @map("discount_gel") @db.Decimal(12, 2)
  totalGel          Decimal           @map("total_gel") @db.Decimal(12, 2)
  commissionStatus  CommissionStatus  @default(NOT_ELIGIBLE) @map("commission_status")
  buyerNote         String?           @map("buyer_note") @db.VarChar(1000)
  // Unanswered orders auto-cancel at this time; delivered orders auto-complete at autoCompleteAt.
  autoCancelAt      DateTime?         @map("auto_cancel_at")
  autoCompleteAt    DateTime?         @map("auto_complete_at")
  acceptedAt        DateTime?         @map("accepted_at")
  dispatchedAt      DateTime?         @map("dispatched_at")
  deliveredAt       DateTime?         @map("delivered_at")
  completedAt       DateTime?         @map("completed_at")
  cancelledAt       DateTime?         @map("cancelled_at")
  cancellationReason String?          @map("cancellation_reason") @db.VarChar(500)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  order       Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller      SellerProfile        @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  history     OrderStatusHistory[]
  delivery    DeliveryArrangement?
  payment     PaymentRecord?
  refunds     Refund[]
  disputes    Dispute[]
  ledgerEntries SellerCommissionLedger[]

  @@index([sellerProfileId, status, createdAt])
  @@index([orderId])
  @@index([status, autoCancelAt])
  @@index([status, autoCompleteAt])
  @@map("seller_orders")
}

model OrderItem {
  id                       BigInt          @id @default(autoincrement())
  sellerOrderId            BigInt          @map("seller_order_id")
  productId                BigInt          @map("product_id")
  variantId                BigInt          @map("variant_id")
  kind                     ProductKind
  titleSnapshot            String          @map("title_snapshot") @db.VarChar(255)
  skuSnapshot              String          @map("sku_snapshot") @db.VarChar(100)
  optionsSnapshot          Json?           @map("options_snapshot")
  unitPriceGel             Decimal         @map("unit_price_gel") @db.Decimal(12, 2)
  quantity                 Int
  lineTotalGel             Decimal         @map("line_total_gel") @db.Decimal(12, 2)
  // Commission rate resolved at placement and frozen here; the ledger uses this value.
  appliedCommissionPercent Decimal         @map("applied_commission_percent") @db.Decimal(5, 2)
  status                   OrderItemStatus @default(ACTIVE)
  createdAt                DateTime        @default(now()) @map("created_at")

  sellerOrder SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  refunds     Refund[]
  ledgerEntries SellerCommissionLedger[]

  @@index([sellerOrderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

// Append-only.
model OrderStatusHistory {
  id            BigInt             @id @default(autoincrement())
  sellerOrderId BigInt             @map("seller_order_id")
  fromStatus    SellerOrderStatus? @map("from_status")
  toStatus      SellerOrderStatus  @map("to_status")
  actorId       BigInt?            @map("actor_id")
  // buyer, seller, admin or system (scheduled jobs).
  actorRole     String             @map("actor_role") @db.VarChar(32)
  reason        String?            @db.VarChar(500)
  createdAt     DateTime           @default(now()) @map("created_at")

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  @@index([sellerOrderId, createdAt])
  @@map("order_status_history")
}

// Delivery is arranged between buyer and seller; the platform only records what they agreed.
model DeliveryArrangement {
  id                BigInt         @id @default(autoincrement())
  sellerOrderId     BigInt         @unique @map("seller_order_id")
  method            DeliveryMethod
  notes             String?        @db.VarChar(1000)
  agreedAt          DateTime?      @map("agreed_at")
  trackingReference String?        @map("tracking_reference") @db.VarChar(100)
  updatedAt         DateTime       @updatedAt @map("updated_at")

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  @@map("delivery_arrangements")
}

// Cash on delivery: the buyer pays the seller directly; the platform only records the claim and
// the confirmations. Status is independent of the order status.
model PaymentRecord {
  id                  BigInt        @id @default(autoincrement())
  sellerOrderId       BigInt        @unique @map("seller_order_id")
  method              PaymentMethod @default(COD)
  status              PaymentStatus @default(AWAITING_COLLECTION)
  amountExpectedGel   Decimal       @map("amount_expected_gel") @db.Decimal(12, 2)
  amountCollectedGel  Decimal?      @map("amount_collected_gel") @db.Decimal(12, 2)
  collectedAt         DateTime?     @map("collected_at")
  recordedById        BigInt?       @map("recorded_by_id")
  buyerConfirmedAt    DateTime?     @map("buyer_confirmed_at")
  note                String?       @db.VarChar(500)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  sellerOrder SellerOrder          @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  history     PaymentStatusHistory[]

  @@index([status])
  @@map("payment_records")
}

// Append-only.
model PaymentStatusHistory {
  id              BigInt        @id @default(autoincrement())
  paymentRecordId BigInt        @map("payment_record_id")
  fromStatus      PaymentStatus? @map("from_status")
  toStatus        PaymentStatus @map("to_status")
  actorId         BigInt?       @map("actor_id")
  actorRole       String        @map("actor_role") @db.VarChar(32)
  reason          String?       @db.VarChar(500)
  createdAt       DateTime      @default(now()) @map("created_at")

  paymentRecord PaymentRecord @relation(fields: [paymentRecordId], references: [id], onDelete: Cascade)

  @@index([paymentRecordId, createdAt])
  @@map("payment_status_history")
}

// Refunds are recorded by the platform but money moves directly between seller and buyer.
model Refund {
  id            BigInt       @id @default(autoincrement())
  uuid          String       @unique @default(uuid()) @db.Char(36)
  sellerOrderId BigInt       @map("seller_order_id")
  orderItemId   BigInt?      @map("order_item_id")
  amountGel     Decimal      @map("amount_gel") @db.Decimal(12, 2)
  reason        String       @db.VarChar(1000)
  status        RefundStatus @default(REQUESTED)
  requestedById BigInt       @map("requested_by_id")
  decidedById   BigInt?      @map("decided_by_id")
  decidedAt     DateTime?    @map("decided_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  orderItem   OrderItem?  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([sellerOrderId])
  @@index([status])
  @@map("refunds")
}

model Dispute {
  id             BigInt        @id @default(autoincrement())
  uuid           String        @unique @default(uuid()) @db.Char(36)
  sellerOrderId  BigInt        @map("seller_order_id")
  openedById     BigInt        @map("opened_by_id")
  type           DisputeType
  status         DisputeStatus @default(OPEN)
  description    String        @db.Text
  resolutionNote String?       @map("resolution_note") @db.Text
  resolvedById   BigInt?       @map("resolved_by_id")
  resolvedAt     DateTime?     @map("resolved_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  sellerOrder SellerOrder       @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  messages    DisputeMessage[]

  @@index([sellerOrderId])
  @@index([status, createdAt])
  @@map("disputes")
}

model DisputeMessage {
  id          BigInt   @id @default(autoincrement())
  disputeId   BigInt   @map("dispute_id")
  authorId    BigInt   @map("author_id")
  authorRole  String   @map("author_role") @db.VarChar(32)
  body        String   @db.Text
  attachments Json?
  createdAt   DateTime @default(now()) @map("created_at")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

// ================================================================ Part 4: finance
//
// Everything here is GEL. Ledger, invoice payments and revenue entries are append-only (enforced by
// triggers in the raw-SQL migration). Corrections are new rows, never edits. Issued invoices are
// frozen; later corrections become reversal/adjustment ledger entries or credit notes.

enum CommissionRuleScope {
  GLOBAL
  CATEGORY
  SELLER
  PROMOTIONAL
}

enum LedgerEntryType {
  ACCRUAL
  REVERSAL
  ADJUSTMENT
}

enum InvoiceType {
  COMMISSION
  LISTING_FEE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PromotionPlacement {
  FEATURED
  HOMEPAGE
  CATEGORY
  SEARCH
}

enum PromotionStatus {
  REQUESTED
  APPROVED
  REJECTED
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentConfirmation {
  UNPAID
  PAID
}

enum RevenueSource {
  COMMISSION
  SUBSCRIPTION
  PROMOTION
  LISTING_FEE
}

// Priority resolution (highest wins): PROMOTIONAL > SELLER > CATEGORY > plan override > GLOBAL.
model CommissionRule {
  id              BigInt              @id @default(autoincrement())
  scope           CommissionRuleScope
  categoryId      BigInt?             @map("category_id")
  sellerProfileId BigInt?             @map("seller_profile_id")
  ratePercent     Decimal             @map("rate_percent") @db.Decimal(5, 2)
  validFrom       DateTime            @map("valid_from")
  validTo         DateTime?           @map("valid_to")
  priority        Int                 @default(0)
  note            String?             @db.VarChar(500)
  createdById     BigInt?             @map("created_by_id")
  createdAt       DateTime            @default(now()) @map("created_at")

  category Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seller   SellerProfile? @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)

  @@index([scope, validFrom, validTo])
  @@index([categoryId])
  @@index([sellerProfileId])
  @@map("commission_rules")
}

// Append-only. Idempotency: one accrual per order item (and correction sequence).
model SellerCommissionLedger {
  id                     BigInt          @id @default(autoincrement())
  sellerProfileId        BigInt          @map("seller_profile_id")
  sellerOrderId          BigInt?         @map("seller_order_id")
  orderItemId            BigInt?         @map("order_item_id")
  entryType              LedgerEntryType @map("entry_type")
  // Increments for each correction against the same order item so the unique key stays meaningful.
  correctionSeq          Int             @default(0) @map("correction_seq")
  grossEligibleAmountGel Decimal         @map("gross_eligible_amount_gel") @db.Decimal(12, 2)
  commissionPercent      Decimal         @map("commission_percent") @db.Decimal(5, 2)
  // Signed: accruals positive, reversals negative, adjustments either.
  commissionAmountGel    Decimal         @map("commission_amount_gel") @db.Decimal(12, 2)
  reversesEntryId        BigInt?         @map("reverses_entry_id")
  reason                 String?         @db.VarChar(1000)
  createdById            BigInt?         @map("created_by_id")
  // 'YYYY-MM' in Asia/Tbilisi time; decides which monthly invoice picks the entry up.
  periodMonth            String          @map("period_month") @db.Char(7)
  createdAt              DateTime        @default(now()) @map("created_at")

  seller      SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  sellerOrder SellerOrder?  @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  orderItem   OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  invoiceItem SellerInvoiceItem?

  @@unique([orderItemId, entryType, correctionSeq])
  @@index([sellerProfileId, periodMonth])
  @@index([sellerOrderId])
  @@map("seller_commission_ledger")
}

// A cache recomputed from the ledger and invoices; never the source of truth.
// A nightly reconciliation job compares it with a fresh calculation.
model SellerBalance {
  id                    BigInt   @id @default(autoincrement())
  sellerProfileId       BigInt   @unique @map("seller_profile_id")
  accruedUninvoicedGel  Decimal  @default(0) @map("accrued_uninvoiced_gel") @db.Decimal(14, 2)
  invoicedOutstandingGel Decimal @default(0) @map("invoiced_outstanding_gel") @db.Decimal(14, 2)
  overdueGel            Decimal  @default(0) @map("overdue_gel") @db.Decimal(14, 2)
  updatedAt             DateTime @updatedAt @map("updated_at")

  seller SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@map("seller_balances")
}

// Gapless invoice numbers: this row is locked (SELECT ... FOR UPDATE) when issuing an invoice.
model InvoiceCounter {
  year       Int @id
  lastNumber Int @default(0) @map("last_number")

  @@map("invoice_counters")
}

model SellerInvoice {
  id              BigInt        @id @default(autoincrement())
  uuid            String        @unique @default(uuid()) @db.Char(36)
  sellerProfileId BigInt        @map("seller_profile_id")
  invoiceType     InvoiceType   @default(COMMISSION) @map("invoice_type")
  // Assigned at issue time, e.g. MM-2026-000123. Null while DRAFT.
  invoiceNumber   String?       @unique @map("invoice_number") @db.VarChar(32)
  // Billing period in Asia/Tbilisi time, stored as dates.
  periodStart     DateTime      @map("period_start") @db.Date
  periodEnd       DateTime      @map("period_end") @db.Date
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime?     @map("issue_date") @db.Date
  dueDate         DateTime?     @map("due_date") @db.Date
  grossEligibleSalesGel Decimal @default(0) @map("gross_eligible_sales_gel") @db.Decimal(14, 2)
  subtotalGel     Decimal       @default(0) @map("subtotal_gel") @db.Decimal(14, 2)
  adjustmentsGel  Decimal       @default(0) @map("adjustments_gel") @db.Decimal(14, 2)
  // Only used if Modernmarket is VAT-registered (business decision pending).
  vatGel          Decimal?      @map("vat_gel") @db.Decimal(14, 2)
  totalGel        Decimal       @default(0) @map("total_gel") @db.Decimal(14, 2)
  paidGel         Decimal       @default(0) @map("paid_gel") @db.Decimal(14, 2)
  // Key in the PRIVATE bucket for the generated PDF.
  pdfKey          String?       @map("pdf_key") @db.VarChar(255)
  issuedById      BigInt?       @map("issued_by_id")
  issuedAt        DateTime?     @map("issued_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  seller      SellerProfile          @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  items       SellerInvoiceItem[]
  payments    SellerInvoicePayment[]
  creditNotes CreditNote[]

  // Makes monthly generation idempotent: re-running cannot create a second invoice for the period.
  @@unique([sellerProfileId, periodStart, periodEnd, invoiceType])
  @@index([status, dueDate])
  @@map("seller_invoices")
}

model SellerInvoiceItem {
  id            BigInt   @id @default(autoincrement())
  invoiceId     BigInt   @map("invoice_id")
  // A ledger entry can appear on exactly one invoice. Null for non-ledger lines (e.g. listing fees).
  ledgerEntryId BigInt?  @unique @map("ledger_entry_id")
  description   String   @db.VarChar(500)
  grossGel      Decimal? @map("gross_gel") @db.Decimal(12, 2)
  amountGel     Decimal  @map("amount_gel") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  invoice     SellerInvoice           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  ledgerEntry SellerCommissionLedger? @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("seller_invoice_items")
}

// Append-only. A mistaken payment is corrected with a negative row.
model SellerInvoicePayment {
  id            BigInt   @id @default(autoincrement())
  invoiceId     BigInt   @map("invoice_id")
  amountGel     Decimal  @map("amount_gel") @db.Decimal(12, 2)
  paidAt        DateTime @map("paid_at")
  reference     String?  @db.VarChar(150)
  evidenceKey   String?  @map("evidence_key") @db.VarChar(255)
  note          String?  @db.VarChar(500)
  recordedById  BigInt   @map("recorded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  invoice SellerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("seller_invoice_payments")
}

// Corrections to an already issued invoice, without rewriting it.
model CreditNote {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @unique @default(uuid()) @db.Char(36)
  invoiceId   BigInt   @map("invoice_id")
  amountGel   Decimal  @map("amount_gel") @db.Decimal(12, 2)
  reason      String   @db.VarChar(1000)
  issuedById  BigInt   @map("issued_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  invoice SellerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("credit_notes")
}

model SubscriptionPlan {
  id                  BigInt   @id @default(autoincrement())
  key                 String   @unique @db.VarChar(64)
  nameKa              String   @map("name_ka") @db.VarChar(100)
  nameEn              String   @map("name_en") @db.VarChar(100)
  monthlyPriceGel     Decimal  @map("monthly_price_gel") @db.Decimal(10, 2)
  maxActiveProducts   Int?     @map("max_active_products")
  promotionAllowance  Int      @default(0) @map("promotion_allowance")
  commissionPercentOverride Decimal? @map("commission_percent_override") @db.Decimal(5, 2)
  features            Json?
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  subscriptions SellerSubscription[]

  @@map("subscription_plans")
}

// No automatic billing: an admin confirms a manual payment, which activates the subscription.
model SellerSubscription {
  id              BigInt             @id @default(autoincrement())
  sellerProfileId BigInt             @map("seller_profile_id")
  planId          BigInt             @map("plan_id")
  status          SubscriptionStatus @default(PENDING_PAYMENT)
  startsAt        DateTime?          @map("starts_at")
  expiresAt       DateTime?          @map("expires_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  seller   SellerProfile        @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  plan     SubscriptionPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments SubscriptionPayment[]

  @@index([sellerProfileId, status])
  @@index([status, expiresAt])
  @@map("seller_subscriptions")
}

// Append-only.
model SubscriptionPayment {
  id             BigInt   @id @default(autoincrement())
  subscriptionId BigInt   @map("subscription_id")
  amountGel      Decimal  @map("amount_gel") @db.Decimal(10, 2)
  paidAt         DateTime @map("paid_at")
  reference      String?  @db.VarChar(150)
  recordedById   BigInt    @map("recorded_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  subscription SellerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId])
  @@map("subscription_payments")
}

model PromotionType {
  id             BigInt             @id @default(autoincrement())
  key            String             @unique @db.VarChar(64)
  placement      PromotionPlacement
  nameKa         String             @map("name_ka") @db.VarChar(100)
  nameEn         String             @map("name_en") @db.VarChar(100)
  pricePerDayGel Decimal            @map("price_per_day_gel") @db.Decimal(10, 2)
  maxSlots       Int                @map("max_slots")
  isActive       Boolean            @default(true) @map("is_active")

  promotions Promotion[]

  @@map("promotion_types")
}

model Promotion {
  id              BigInt              @id @default(autoincrement())
  uuid            String              @unique @default(uuid()) @db.Char(36)
  sellerProfileId BigInt              @map("seller_profile_id")
  productId       BigInt              @map("product_id")
  typeId          BigInt              @map("type_id")
  // Category placements only: which category page the product is promoted on.
  categoryId      BigInt?             @map("category_id")
  status          PromotionStatus     @default(REQUESTED)
  startsAt        DateTime            @map("starts_at")
  endsAt          DateTime            @map("ends_at")
  priceGel        Decimal             @map("price_gel") @db.Decimal(10, 2)
  paymentStatus   PaymentConfirmation @default(UNPAID) @map("payment_status")
  decidedById     BigInt?             @map("decided_by_id")
  rejectionReason String?             @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  seller   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  type     PromotionType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([status, startsAt, endsAt])
  @@index([sellerProfileId])
  @@index([productId])
  @@map("promotions")
}

// Append-only. Gives analytics a clean, separate record of platform revenue by source.
// Buyer COD collections are never recorded here: they are the seller's money.
model PlatformRevenueEntry {
  id            BigInt        @id @default(autoincrement())
  source        RevenueSource
  amountGel     Decimal       @map("amount_gel") @db.Decimal(14, 2)
  referenceType String        @map("reference_type") @db.VarChar(64)
  referenceId   String        @map("reference_id") @db.VarChar(64)
  recognizedAt  DateTime      @map("recognized_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@unique([source, referenceType, referenceId])
  @@index([source, recognizedAt])
  @@map("platform_revenue_entries")
}
