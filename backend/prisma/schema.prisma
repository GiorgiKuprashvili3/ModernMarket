// Modernmarket database schema.
// Part 1 (Milestone 1): identity, authentication, seller onboarding, and platform foundations.
// Catalog, inventory, orders and finance models are added in later steps/milestones.
//
// Conventions:
//  - Internal primary keys are BigInt auto-increment and never leave the backend.
//  - Public identifiers are `uuid` columns.
//  - Money is Decimal (GEL only). Timestamps are UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Enums

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  BLOCKED
}

enum Locale {
  ka
  en
}

enum DisplayCurrency {
  GEL
  USD
  EUR
}

enum SellerType {
  INDIVIDUAL
  BUSINESS
}

enum SellerStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

// ---------------------------------------------------------------- Identity

model User {
  id                BigInt          @id @default(autoincrement())
  uuid              String          @unique @default(uuid()) @db.Char(36)
  email             String          @unique @db.VarChar(255)
  passwordHash      String          @map("password_hash") @db.VarChar(255)
  status            UserStatus      @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?       @map("email_verified_at")
  locale            Locale          @default(ka)
  displayCurrency   DisplayCurrency @default(GEL) @map("display_currency")
  lastLoginAt       DateTime?       @map("last_login_at")
  failedLoginCount  Int             @default(0) @map("failed_login_count")
  lockedUntil       DateTime?       @map("locked_until")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  roles                  UserRole[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  buyerProfile           BuyerProfile?
  sellerProfile          SellerProfile?
  addresses              Address[]
  auditLogs              AuditLog[]

  @@map("users")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @db.VarChar(64) // buyer, seller, admin, super_admin, ...
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @db.VarChar(100) // e.g. products.moderate, invoices.issue
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    BigInt   @map("user_id")
  roleId    BigInt   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------- Auth tokens
// Only hashes are stored. Refresh tokens rotate on every use; `familyId` groups a
// rotation chain so reuse of an old token can revoke the whole family.

model RefreshToken {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  familyId     String    @map("family_id") @db.Char(36)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById BigInt?   @map("replaced_by_id")
  ip           String?   @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------------- Profiles

model BuyerProfile {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @unique @map("user_id")
  firstName   String   @map("first_name") @db.VarChar(100)
  lastName    String   @map("last_name") @db.VarChar(100)
  phone       String?  @db.VarChar(32)
  preferences Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("buyer_profiles")
}

model SellerProfile {
  id                  BigInt       @id @default(autoincrement())
  uuid                String       @unique @default(uuid()) @db.Char(36)
  userId              BigInt       @unique @map("user_id")
  sellerType          SellerType   @map("seller_type")
  legalName           String       @map("legal_name") @db.VarChar(255)
  // Georgian personal (11-digit) or company identification number.
  // Stored encrypted at the application layer; never logged.
  identificationEnc   String?      @map("identification_enc") @db.Text
  phone               String       @db.VarChar(32)
  contactAddress      String       @map("contact_address") @db.VarChar(500)
  status              SellerStatus @default(PENDING)
  approvedAt          DateTime?    @map("approved_at")
  approvedById        BigInt?      @map("approved_by_id")
  suspendedAt         DateTime?    @map("suspended_at")
  suspendedReason     String?      @map("suspended_reason") @db.VarChar(500)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications SellerApplication[]
  store        SellerStore?
  products     Product[]

  @@index([status])
  @@map("seller_profiles")
}

model Address {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @unique @default(uuid()) @db.Char(36)
  userId    BigInt   @map("user_id")
  label     String?  @db.VarChar(64)
  recipient String   @db.VarChar(150)
  phone     String   @db.VarChar(32)
  city      String   @db.VarChar(100)
  district  String?  @db.VarChar(100)
  street    String   @db.VarChar(255)
  building  String?  @db.VarChar(64)
  notes     String?  @db.VarChar(500)
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------- Seller onboarding

model SellerApplication {
  id              BigInt            @id @default(autoincrement())
  uuid            String            @unique @default(uuid()) @db.Char(36)
  sellerProfileId BigInt            @map("seller_profile_id")
  status          ApplicationStatus @default(PENDING)
  storeName       String            @map("store_name") @db.VarChar(150)
  storeDescription String?          @map("store_description") @db.Text
  revisionNo      Int               @default(1) @map("revision_no")
  submittedAt     DateTime          @default(now()) @map("submitted_at")
  reviewedById    BigInt?           @map("reviewed_by_id")
  reviewedAt      DateTime?         @map("reviewed_at")
  rejectionReason String?           @map("rejection_reason") @db.VarChar(1000)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  sellerProfile SellerProfile    @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  documents     SellerDocument[]

  @@index([sellerProfileId])
  @@index([status, submittedAt])
  @@map("seller_applications")
}

model SellerDocument {
  id            BigInt   @id @default(autoincrement())
  uuid          String   @unique @default(uuid()) @db.Char(36)
  applicationId BigInt   @map("application_id")
  docType       String   @map("doc_type") @db.VarChar(64)
  // Key inside the PRIVATE bucket. Never exposed directly; access goes through the API.
  storageKey    String   @map("storage_key") @db.VarChar(255)
  mimeType      String   @map("mime_type") @db.VarChar(100)
  sizeBytes     Int      @map("size_bytes")
  checksum      String   @db.Char(64)
  createdAt     DateTime @default(now()) @map("created_at")

  application SellerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("seller_documents")
}

// ---------------------------------------------------------------- Platform foundations

// Append-only: the application never updates or deletes rows.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt?  @map("actor_id")
  actorRole  String?  @map("actor_role") @db.VarChar(64)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.VarChar(64)
  before     Json?
  after      Json?
  reason     String?  @db.VarChar(1000)
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// Transactional outbox: written in the same transaction as the change, dispatched by a worker.
model OutboxEvent {
  id            BigInt       @id @default(autoincrement())
  eventType     String       @map("event_type") @db.VarChar(100)
  aggregateType String       @map("aggregate_type") @db.VarChar(64)
  aggregateId   String       @map("aggregate_id") @db.VarChar(64)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error") @db.Text
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  processedAt   DateTime?    @map("processed_at")

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model PlatformSetting {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  updatedById BigInt?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// Stores the response of a state-changing request so a retry with the same key
// (e.g. checkout) returns the original result instead of creating a duplicate.
model IdempotencyKey {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  key          String   @db.VarChar(128)
  requestHash  String   @map("request_hash") @db.Char(64)
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ================================================================ Part 2: catalog and inventory
//
// Design decisions:
//  - Every physical or digital product has at least one variant (a "default" variant for simple
//    products). Price, SKU and stock live on the variant, so cart/order/inventory code has a
//    single purchasable unit. Vehicles have no variants and no inventory (inquiry-only).
//  - FULLTEXT indexes on product_translations are created in a raw-SQL migration
//    (Prisma cannot express everything we need for Georgian search tuning).
//  - The single exactly-one-of / range CHECK constraints are also added in raw SQL.

enum StoreStatus {
  OPEN
  CLOSED
  SUSPENDED
}

enum ProductKind {
  PHYSICAL
  DIGITAL
  VEHICLE
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum ProductStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
  SUSPENDED
}

enum ModerationAction {
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED_AFTER_EDIT
  SUSPENDED
  REINSTATED
}

enum AttributeType {
  TEXT
  NUMBER
  ENUM
  BOOLEAN
}

enum VehicleListingStatus {
  AVAILABLE
  RESERVED
  SOLD
  ARCHIVED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUG_IN_HYBRID
  ELECTRIC
  LPG
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
  CVT
}

enum DriveType {
  FWD
  RWD
  AWD
  FOUR_WD
}

enum InventoryMovementType {
  INITIAL
  ADJUSTMENT
  RESERVE
  RELEASE
  COMMIT
  RESTOCK
}

model SellerStore {
  id              BigInt      @id @default(autoincrement())
  uuid            String      @unique @default(uuid()) @db.Char(36)
  sellerProfileId BigInt      @unique @map("seller_profile_id")
  slug            String      @unique @db.VarChar(120)
  name            String      @db.VarChar(150)
  descriptionKa   String?     @map("description_ka") @db.Text
  descriptionEn   String?     @map("description_en") @db.Text
  policiesKa      String?     @map("policies_ka") @db.Text
  policiesEn      String?     @map("policies_en") @db.Text
  location        String?     @db.VarChar(255)
  logoKey         String?     @map("logo_key") @db.VarChar(255)
  coverKey        String?     @map("cover_key") @db.VarChar(255)
  status          StoreStatus @default(OPEN)
  ratingAvg       Decimal     @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount     Int         @default(0) @map("rating_count")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  products      Product[]

  @@map("seller_stores")
}

model Category {
  id                BigInt      @id @default(autoincrement())
  uuid              String      @unique @default(uuid()) @db.Char(36)
  parentId          BigInt?     @map("parent_id")
  slug              String      @unique @db.VarChar(150)
  // Materialized path of ancestor ids, e.g. "/1/14/" for fast subtree queries.
  path              String      @db.VarChar(255)
  depth             Int         @default(0)
  sortOrder         Int         @default(0) @map("sort_order")
  isActive          Boolean     @default(true) @map("is_active")
  imageKey          String?     @map("image_key") @db.VarChar(255)
  // Which product kind this category hosts; vehicles must live under a vehicle category.
  productKind       ProductKind @default(PHYSICAL) @map("product_kind")
  // Optional category-level commission override (resolved by the commission module).
  commissionPercent Decimal?    @map("commission_percent") @db.Decimal(5, 2)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  parent        Category?               @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Category[]              @relation("CategoryTree")
  translations  CategoryTranslation[]
  products      Product[]
  attributes    AttributeDefinition[]

  @@index([parentId, sortOrder])
  @@index([path])
  @@map("categories")
}

model CategoryTranslation {
  id             BigInt  @id @default(autoincrement())
  categoryId     BigInt  @map("category_id")
  locale         Locale
  name           String  @db.VarChar(150)
  description    String? @db.Text
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(500)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model Brand {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @unique @default(uuid()) @db.Char(36)
  slug      String   @unique @db.VarChar(150)
  name      String   @db.VarChar(150)
  logoKey   String?  @map("logo_key") @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model Product {
  id                 BigInt           @id @default(autoincrement())
  uuid               String           @unique @default(uuid()) @db.Char(36)
  sellerProfileId    BigInt           @map("seller_profile_id")
  storeId            BigInt           @map("store_id")
  categoryId         BigInt           @map("category_id")
  brandId            BigInt?          @map("brand_id")
  kind               ProductKind
  slug               String           @unique @db.VarChar(200)
  condition          ProductCondition @default(NEW)
  location           String?          @db.VarChar(255)
  // Display price of the cheapest active variant, kept in sync by the service for fast listing/sorting.
  // Never used for checkout; the variant price is authoritative.
  minPriceGel        Decimal?         @map("min_price_gel") @db.Decimal(12, 2)
  compareAtPriceGel  Decimal?         @map("compare_at_price_gel") @db.Decimal(12, 2)
  discountPercent    Int              @default(0) @map("discount_percent")
  status             ProductStatus    @default(DRAFT)
  moderationRevision Int              @default(0) @map("moderation_revision")
  publishedAt        DateTime?        @map("published_at")
  ratingAvg          Decimal          @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount        Int              @default(0) @map("rating_count")
  viewCount          Int              @default(0) @map("view_count")
  salesCount         Int              @default(0) @map("sales_count")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")

  seller        SellerProfile              @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  store         SellerStore                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category      Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand         Brand?                     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  translations  ProductTranslation[]
  images        ProductImage[]
  variants      ProductVariant[]
  attributes    ProductAttributeValue[]
  moderation    ProductModerationHistory[]
  vehicle       VehicleDetails?
  digitalFiles  DigitalProductFile[]

  @@index([status, categoryId, publishedAt])
  @@index([sellerProfileId, status])
  @@index([status, minPriceGel])
  @@index([status, ratingAvg])
  @@index([status, salesCount])
  @@index([brandId])
  @@map("products")
}

model ProductTranslation {
  id             BigInt  @id @default(autoincrement())
  productId      BigInt  @map("product_id")
  locale         Locale
  title          String  @db.VarChar(255)
  description    String  @db.Text
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(500)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  // FULLTEXT (title, description) is added in a raw-SQL migration.
  @@map("product_translations")
}

model ProductVariant {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique @default(uuid()) @db.Char(36)
  productId  BigInt   @map("product_id")
  sku        String   @db.VarChar(100)
  priceGel   Decimal  @map("price_gel") @db.Decimal(12, 2)
  // Free-form configurable options, e.g. {"size":"M","color":"Black"}.
  options    Json?
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?
  images    ProductImage[]

  // SKU is unique within a product; cross-product uniqueness per seller is enforced in the service.
  @@unique([productId, sku])
  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id         BigInt   @id @default(autoincrement())
  productId  BigInt   @map("product_id")
  variantId  BigInt?  @map("variant_id")
  storageKey String   @map("storage_key") @db.VarChar(255)
  altKa      String?  @map("alt_ka") @db.VarChar(255)
  altEn      String?  @map("alt_en") @db.VarChar(255)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// Category-specific attribute definitions drive filters, specifications and comparison.
model AttributeDefinition {
  id            BigInt        @id @default(autoincrement())
  categoryId    BigInt        @map("category_id")
  key           String        @db.VarChar(64)
  type          AttributeType
  nameKa        String        @map("name_ka") @db.VarChar(150)
  nameEn        String        @map("name_en") @db.VarChar(150)
  // For ENUM type: [{ "value": "ssd", "ka": "...", "en": "SSD" }, ...]
  options       Json?
  unit          String?       @db.VarChar(32)
  isFilterable  Boolean       @default(false) @map("is_filterable")
  isComparable  Boolean       @default(false) @map("is_comparable")
  isRequired    Boolean       @default(false) @map("is_required")
  sortOrder     Int           @default(0) @map("sort_order")

  category Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values   ProductAttributeValue[]

  @@unique([categoryId, key])
  @@map("attribute_definitions")
}

model ProductAttributeValue {
  id            BigInt   @id @default(autoincrement())
  productId     BigInt   @map("product_id")
  attributeId   BigInt   @map("attribute_id")
  valueText     String?  @map("value_text") @db.VarChar(500)
  valueNumber   Decimal? @map("value_number") @db.Decimal(18, 4)
  valueBoolean  Boolean? @map("value_boolean")
  optionValue   String?  @map("option_value") @db.VarChar(100)

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([attributeId, optionValue])
  @@index([attributeId, valueNumber])
  @@map("product_attribute_values")
}

// Append-only record of every moderation decision.
model ProductModerationHistory {
  id         BigInt           @id @default(autoincrement())
  productId  BigInt           @map("product_id")
  revisionNo Int              @map("revision_no")
  action     ModerationAction
  actorId    BigInt?          @map("actor_id")
  reason     String?          @db.VarChar(1000)
  // What was reviewed at that moment.
  snapshot   Json?
  createdAt  DateTime         @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("product_moderation_history")
}

model VehicleDetails {
  id            BigInt               @id @default(autoincrement())
  productId     BigInt               @unique @map("product_id")
  manufacturer  String               @db.VarChar(100)
  model         String               @db.VarChar(100)
  year          Int
  mileageKm     Int                  @map("mileage_km")
  engine        String?              @db.VarChar(100)
  fuelType      FuelType             @map("fuel_type")
  transmission  Transmission
  driveType     DriveType?           @map("drive_type")
  priceGel      Decimal              @map("price_gel") @db.Decimal(12, 2)
  listingStatus VehicleListingStatus @default(AVAILABLE) @map("listing_status")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([manufacturer, model, year])
  @@index([listingStatus])
  @@map("vehicle_details")
}

model DigitalProductFile {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique @default(uuid()) @db.Char(36)
  productId  BigInt   @map("product_id")
  // Key inside the PRIVATE bucket; never exposed. Downloads go through an authorized API endpoint.
  storageKey String   @map("storage_key") @db.VarChar(255)
  filename   String   @db.VarChar(255)
  sizeBytes  BigInt   @map("size_bytes")
  checksum   String   @db.Char(64)
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("digital_product_files")
}

// ---------------------------------------------------------------- Inventory
// Stock is decremented atomically in the checkout transaction:
//   UPDATE inventory SET quantity_on_hand = quantity_on_hand - :q
//   WHERE id = :id AND quantity_on_hand >= :q
// A CHECK (quantity_on_hand >= 0) is added in the raw-SQL migration as a second line of defense.

model Inventory {
  id               BigInt   @id @default(autoincrement())
  variantId        BigInt   @unique @map("variant_id")
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  lowStockThreshold Int     @default(3) @map("low_stock_threshold")
  updatedAt        DateTime @updatedAt @map("updated_at")

  variant   ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@map("inventory")
}

// Append-only ledger of every stock change.
model InventoryMovement {
  id            BigInt                @id @default(autoincrement())
  inventoryId   BigInt                @map("inventory_id")
  type          InventoryMovementType
  delta         Int
  referenceType String?               @map("reference_type") @db.VarChar(64)
  referenceId   String?               @map("reference_id") @db.VarChar(64)
  actorId       BigInt?               @map("actor_id")
  note          String?               @db.VarChar(500)
  createdAt     DateTime              @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}
